# BigWigs packager / CurseForge metadata
# https://github.com/BigWigsMods/packager
#
# Addon sources live in NeedfulSlots/ (so the repository is easy to browse).
# The hand-built player zip has that folder at the top level:
# NeedfulSlots/NeedfulSlots.toc, not
# NeedfulSlots/NeedfulSlots/...
#
# If you later run BigWigs packager against this repository, point it at the
# NeedfulSlots subdirectory (or flatten the toc/lua to the repo root)
# so the zip does not nest an extra folder. package-as must match the folder
# and toc name.
package-as: NeedfulSlots

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Do not ship tests, repo docs, or git metadata inside the player zip.
ignore:
  - test
  - screenshots
  - README.md
  - CHANGELOG.md
  - .gitignore
  - .github
